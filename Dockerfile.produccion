# Imagen de producción: compila el panel y lo sirve con Nginx, que además
# reenvía /api y /static al backend (ver nginx.conf).
#
#   docker build -f Dockerfile.produccion -t sentinel-panel .
#
# El Dockerfile normal levanta el servidor de desarrollo y no sirve para esto.

FROM node:22-alpine AS compilacion
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# La API está en la misma dirección que el panel, detrás de Nginx.
ENV REACT_APP_API_BASE=/api/v1
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=compilacion /app/build /usr/share/nginx/html
EXPOSE 80
