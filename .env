# Configuracion para desarrollo local (backend en Docker, puerto 8000).
# En produccion estos valores se definen en el panel de Vercel, no aqui.
#
# REACT_APP_WS_BASE admite el endpoint completo (como esta abajo) o solo el
# host: el codigo completa la ruta si falta. Antes no lo hacia, y dejarlo en
# "ws://localhost:8000" provocaba un 403 que dejaba al panel sin alertas en vivo.

REACT_APP_API_BASE=http://localhost:8000/api/v1
REACT_APP_WS_BASE=ws://localhost:8000/api/v1/ws/alerts
